# Copy to .env (or just run: make secrets). Never commit .env.
# Leave values empty here. `scripts/gen_secrets.py` fills every empty key in .env
# with a generated password, EXCEPT GROQ_API_KEY, which you paste in yourself.
# Later phases append the keys their services need.

# LLM inference (open-weight models on Groq). Used from S1 onward, only by LiteLLM.
GROQ_API_KEY=
# A second Groq account's key: LiteLLM uses it when the first key's daily quota is spent (and spreads calls over both)
GROQ_API_KEY_2=

# L1 — Odoo 17 ERP
# Postgres role "odoo"
ODOO_DB_PASSWORD=
# Odoo database-manager master password
ODOO_MASTER_PASSWORD=
# login "admin" (Vikram, IT admin)
ODOO_ADMIN_PASSWORD=
# login "office": the ONE shared estimator account (W3)
ODOO_OFFICE_PASSWORD=

# L4 — file server \\fileserver\Quotes: ONE password everybody shares (W16)
FILESHARE_PASSWORD=

# L5 — mail server (docker-mailserver) for apex.local, customers.local, suppliers.local
# rfq@apex.local: the ONE shared mailbox password every estimator knows (W3)
MAIL_RFQ_PASSWORD=
# estimator1@, senior@, purchasing@ (apex.local)
MAIL_STAFF_PASSWORD=
# every simulated customer mailbox (customers.local); ponytail: one per domain, it's simulated outsiders
MAIL_CUSTOMERS_PASSWORD=
# every simulated supplier mailbox (suppliers.local)
MAIL_SUPPLIERS_PASSWORD=

# S1 — agent platform (docker-compose.agent.yml). All generated; never shown.
# app-postgres superuser, and one role per service database
APP_PG_PASSWORD=
APEX_DB_PASSWORD=
LITELLM_DB_PASSWORD=
LANGFUSE_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_PASSWORD=
CLICKHOUSE_PASSWORD=
# Langfuse (LLM tracing): server secrets, the project API keys, the admin login (admin@apex.local)
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ADMIN_PASSWORD=
# LiteLLM (the only AI gateway, the only holder of GROQ_API_KEY): master key, credential salt, UI login "admin"
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_UI_PASSWORD=
# One LiteLLM virtual key per agent (config/agents.yaml); registered by agent/ops/litellm/keys.py
LITELLM_KEY_SECURITY_GATE=
LITELLM_KEY_TRIAGE=
LITELLM_KEY_EXTRACTOR=
LITELLM_KEY_DRAFTER=
LITELLM_KEY_WHATIF=
# Keycloak admin (user "admin") and Grafana admin (user "admin")
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# S2 — the agent's OWN scoped accounts (replacing the shared logins, W3)
# Odoo: erp_reader (read-only) and erp_integration (sales/purchase user), created by agent/ops/provision_access.py
ODOO_READER_PASSWORD=
ODOO_INTEGRATION_PASSWORD=
# Samba: user agent-ro, read-only on \fileserver\Quotes
FILESHARE_AGENT_PASSWORD=
# Dovecot master user "agent": logs in to rfq@ as "rfq@apex.local*agent" (its own password, logged as agent)
MAIL_AGENT_PASSWORD=

# S3 — ingestion and the security gate
# MinIO user "apex-agent": read/write on the bucket "apex" only (raw mail, files, quarantine), created by provision_access
MINIO_AGENT_PASSWORD=
# Postgres role "grafana_ro": SELECT on the triage tables only, for the Grafana "Inbox triage" dashboard
GRAFANA_DB_PASSWORD=

# S7 — the review screen (https://localhost:8448) and access control
# One lab password for the Keycloak staff logins arjun, ramesh, kavita, meera, vikram (realm apex), created by provision_access.
# ponytail: one password for the classroom; each person sets their own in a real rollout (Keycloak "update password").
KEYCLOAK_STAFF_PASSWORD=
# the review-ui client's secret (Keycloak <-> Envoy's oauth2 filter) and the key that signs Envoy's login cookies
REVIEW_UI_CLIENT_SECRET=
REVIEW_UI_HMAC_SECRET=
# Postgres role "review_ui" (reads the review tables, may update only jobs.status/decision) and MinIO user "review-ui" (reads raw/, files/)
REVIEW_UI_DB_PASSWORD=
MINIO_REVIEW_PASSWORD=
# S16: the what-if assistant's own Postgres role and MinIO user (read the models only)
WHATIF_DB_PASSWORD=
MINIO_WHATIF_PASSWORD=

# S8 — actions after approval
# Signs the approval token (review screen) and verifies it (OPA, apex/actions). The worker never has it.
APPROVAL_SIGNING_KEY=

# S9 — governance
# Postgres role "apex_audit": INSERT only on the hash-chained audit_log (every service writes its audit through it)
AUDIT_DB_PASSWORD=
